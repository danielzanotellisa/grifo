# Postgres: the app connects with a role that CANNOT bypass RLS (ADR 0016).
DATABASE_URL=postgres://app_user:app_user@localhost:5432/grifo
# Authentication library: the only role that can read the identity schema (ADR 0034).
DATABASE_AUTH_URL=postgres://auth_user:auth_user@localhost:5432/grifo
# Migrations and admin jobs (purge, restore tests) use the owner role.
DATABASE_MIGRATOR_URL=postgres://postgres:postgres@localhost:5432/grifo

# S3-compatible object storage (SeaweedFS locally, ADR 0026)
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=devaccesskey
S3_SECRET_ACCESS_KEY=devsecretkey
S3_FORCE_PATH_STYLE=true
S3_BUCKET_ORIGINALS=originals
S3_BUCKET_DERIVED=derived
S3_BUCKET_BACKUPS=backups

# ClamAV daemon (ADR 0017)
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# Gotenberg: HTML -> PDF for summaries (ADR 0028)
GOTENBERG_URL=http://localhost:3100

# Mail (Mailpit captures everything locally)
SMTP_HOST=localhost
SMTP_PORT=1025

APP_URL=http://localhost:3000

# Authentication (ADR 0034). The secret must have at least 32 characters; generate one per environment.
BETTER_AUTH_SECRET=change-me-change-me-change-me-change-me
